# ============================================================
# Modèle de configuration — copier en .env.local (XAMPP) ou
# .env.production (hébergement). Ne JAMAIS commiter les vrais
# fichiers .env* : ils contiennent les identifiants de la base.
# ============================================================

APP_ENV=local
APP_DEBUG=true
FORCE_HTTPS=false
BASE_URL=

# Clé secrète unique par installation (min. 32 caractères).
# Générer avec : php -r "echo bin2hex(random_bytes(32));"
# Si vide, une clé est générée automatiquement dans storage/app_secret.key
APP_SECRET_KEY=

DB_HOST=127.0.0.1
DB_NAME=garage_db1
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4
